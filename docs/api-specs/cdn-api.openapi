  '/external/api/v1/zones/{zone_uuid}/firewalls/access-management':
    get:
      summary: 'Index Firewall Rules'
      operationId: indexFirewallRules
      description: 'Index firewall rules for a specific zone.'
      parameters:
        -
          in: query
          name: per_page
          description: 'The number of items per page.'
          example: 10
          required: false
          schema:
            type: integer
            description: 'The number of items per page.'
            example: 10
            nullable: true
            minimum: 1
            maximum: 100
        -
          in: query
          name: page
          description: 'The current page.'
          example: 1
          required: false
          schema:
            type: integer
            description: 'The current page.'
            example: 1
            nullable: true
            minimum: 1
      responses:
        200:
          description: success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Firewall rules retrieved'
                  data:
                    -
                      id: vpaO2roj
                      type: ip
                      value: 192.168.1.10
                      action: block
