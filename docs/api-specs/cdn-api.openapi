        - Dns
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                host:
                  type: string
                  description: 'If the host is @, it will be the apex domain.'
                  example: subdomain
                  maxLength: 255
                type:
                  type: string
                  description: 'Supported types: A, CNAME, MX, TXT, NS, SRV, CAA. If a record with the same host and type already exists, it will be appended to the existing records.'
                  example: A
                  enum:
                    - A
                    - CNAME
                    - NS
                    - MX
                    - TXT
                    - SRV
                    - CAA
                ttl:
                  type: integer
                  description: 'TTL for the record.'
                  example: 3600
                  enum:
                    - 1
                    - 2
                    - 5
                    - 10
                    - 30
                    - 60
                    - 180
                    - 300
                    - 600
                    - 900
                    - 1800
                    - 2700
                    - 3600
                    - 10800
                    - 18000
                    - 36000
                    - 43200
                    - 86400
                    - 259200
                    - 604800
                    - 864000
                    - 1296000
                    - 2592000
                proxy:
                  type: string
                  description: 'Proxy mode for the record.'
                  example: cdn-smart-caching
                  enum:
                    - direct
                    - cdn-no-caching
                    - cdn-static-caching
                    - cdn-smart-caching
                    - cdn-always-caching
                load_balance_id:
                  type: string
                  description: 'The ID of the load balance.'
                  example: AbCdEfGh
                  nullable: true
                record:
                  type: object
                  description: ''
                  example:
                    content: 1.1.1.1
                  properties:
                    content:
                      type: string
                      description: 'Content for the record.'
                      example: 1.1.1.1
                      minLength: 2
                      maxLength: 255
                    port:
                      type: integer
                      description: 'Used for SRV records.'
                      example: 5060
                      nullable: true
                      minimum: 1
                      maximum: 65535
                    weight:
                      type: integer
                      description: 'Used for SRV records.'
                      example: 5
                      nullable: true
                    priority:
                      type: integer
                      description: 'Used for MX and SRV records.'
                      example: 10
                      nullable: true
                    flags:
                      type: integer
                      description: 'Used for CAA records.'
                      example: 0
                      nullable: true
                      minimum: 0
                      maximum: 0
                    tag:
                      type: string
                      description: 'Used for CAA records.'
                      example: issue
                      nullable: true
                      enum:
                        - issue
                        - issuewild
                        - iodef
                  required:
                    - content
              required:
                - host
                - type
                - ttl
                - proxy
                - record
