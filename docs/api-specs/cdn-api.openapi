  /external/api/v2/orders:
    post:
      summary: Order
      operationId: order
      description: "Create and setup a new zone with DNS records. This endpoint handles domain registration,\nplan selection, billing configuration, and initial DNS record setup in a single operation.\n\nDefault MX records will be automatically created with host @ and content mail.domain.com if not provided.\n\nDefault NS records will be automatically created for the zone if not specified in the request."
      parameters: []
      responses:
        201:
          description: ''
          content:
            application/json:
              schema:
                oneOf:
                  -
                    description: Success
                    type: object
                    example:
                      success: true
                      message: 'Operation finished successfully.'
                      data:
                        zone_id: 123e4567-e89b-12d3-a456-426614174000
                        ns_records:
                          ns1: zulauf.com
                          ns2: zulauf.com
                          ns3: ''
                          ns4: ''
                        status: active
                        warnings: []
                    properties:
                      success:
                        type: boolean
                        example: true
                      message:
                        type: string
                        example: 'Operation finished successfully.'
                      data:
                        type: object
                        properties:
                          zone_id:
                            type: string
                            example: 123e4567-e89b-12d3-a456-426614174000
                          ns_records:
                            type: object
                            properties:
                              ns1:
                                type: string
                                example: zulauf.com
                              ns2:
                                type: string
                                example: zulauf.com
                              ns3:
                                type: string
                                example: ''
                              ns4:
                                type: string
                                example: ''
                          status:
                            type: string
                            example: active
                          warnings:
                            type: array
                            example: []
                  -
                    description: 'Not enough money in account'
                    type: object
                    example:
                      success: true
                      message: 'Operation finished successfully.'
                      data:
                        zone_id: 123e4567-e89b-12d3-a456-426614174000
                        status: payment_pending
                        warnings:
                          - 'The website has been successfully created, but your account balance is not sufficient to activate the website.'
                    properties:
                      success:
                        type: boolean
                        example: true
                      message:
                        type: string
                        example: 'Operation finished successfully.'
                      data:
                        type: object
                        properties:
                          zone_id:
                            type: string
                            example: 123e4567-e89b-12d3-a456-426614174000
                          status:
                            type: string
                            example: payment_pending
                          warnings:
                            type: array
                            example:
                              - 'The website has been successfully created, but your account balance is not sufficient to activate the website.'
                            items:
                              type: string
                  -
                    description: 'Records failed'
                    type: object
                    example:
                      success: true
                      message: 'Operation finished successfully.'
                      data:
                        zone_id: 123e4567-e89b-12d3-a456-426614174000
                        status: setup_required
                        warnings:
                          - 'The website has been successfully created, but failed to create dns records!'
                    properties:
                      success:
                        type: boolean
                        example: true
                      message:
                        type: string
                        example: 'Operation finished successfully.'
                      data:
                        type: object
                        properties:
                          zone_id:
                            type: string
                            example: 123e4567-e89b-12d3-a456-426614174000
                          status:
                            type: string
                            example: setup_required
                          warnings:
                            type: array
                            example:
                              - 'The website has been successfully created, but failed to create dns records!'
                            items:
                              type: string
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'The x-parameter parameter is required.'
                  errors:
                    x-parameter:
                      - 'The x-parameter is required.'
                properties:
                  message:
                    type: string
                    example: 'The x-parameter parameter is required.'
                  errors:
                    type: object
                    properties:
                      x-parameter:
                        type: array
                        example:
                          - 'The x-parameter is required.'
                        items:
                          type: string
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
      tags:
        - Order
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                domain:
                  type: string
                  description: ''
                  example: example.com
                  maxLength: 255
                plan:
                  type: string
                  description: ''
                  example: free
                  enum:
                    - free
                    - standard
                    - premium
                    - professional
                billing_cycle:
                  type: string
                  description: ''
                  example: free
                  enum:
                    - free
                    - monthly
                    - quarterly
                    - semiannually
                    - annually
                promotion_code:
                  type: string
                  description: ''
                  example: sample-promotion-code
                  nullable: true
                  maxLength: 255
                records:
                  type: array
                  description: 'array of the records to store'
                  example:
                    -
                      host: subdomain
                      type: A
                      ttl: 3600
                      proxy: cdn-smart-caching
                      records:
                        -
                          content: 1.1.1.1
                  items:
                    type: object
                    properties:
                      host:
                        type: string
                        description: ''
                        example: subdomain
                        maxLength: 255
                      type:
                        type: string
                        description: ''
                        example: A
                        enum:
                          - A
                          - CNAME
                          - NS
                          - MX
                          - TXT
                          - SRV
                          - CAA
                      ttl:
                        type: integer
                        description: ''
                        example: 3600
                        enum:
                          - 1
                          - 2
                          - 5
                          - 10
                          - 30
                          - 60
                          - 180
                          - 300
                          - 600
                          - 900
                          - 1800
                          - 2700
                          - 3600
                          - 10800
                          - 18000
                          - 36000
                          - 43200
                          - 86400
                          - 259200
                          - 604800
                          - 864000
                          - 1296000
                          - 2592000
                      proxy:
                        type: string
                        description: ''
                        example: cdn-smart-caching
                        enum:
                          - direct
                          - cdn-no-caching
                          - cdn-static-caching
                          - cdn-smart-caching
                          - cdn-always-caching
                      records:
                        type: array
                        description: 'DNS record values.'
                        example:
                          -
                            content: 1.1.1.1
                        items:
                          type: object
                          properties:
                            content:
                              type: string
                              description: ''
                              example: 1.1.1.1
                              minLength: 2
                              maxLength: 255
                            port:
                              type: integer
                              description: ''
                              example: 80
                              nullable: true
                              minimum: 1
                              maximum: 65535
                            weight:
                              type: integer
                              description: ''
                              example: 10
                              nullable: true
                            priority:
                              type: integer
                              description: ''
                              example: 10
                              nullable: true
                            flags:
                              type: integer
                              description: ''
                              example: 0
                              nullable: true
                              minimum: 0
                              maximum: 0
                            tag:
                              type: string
                              description: ''
                              example: issue
                              nullable: true
                              enum:
                                - issue
                                - issuewild
                                - iodef
                          required:
                            - content
                    required:
                      - host
                      - type
                      - ttl
                      - proxy
                      - records
              required:
                - domain
                - plan
                - billing_cycle
                - records
  '/external/api/v1/zones/{zone_uuid}/origin-rules':
    get:
      summary: 'Index Origin Rules'
      operationId: indexOriginRules
      description: 'List origin rules for a specific zone.'
      parameters:
        -
          in: query
          name: name
          description: 'Filter by origin rule name.'
          example: sample-rule
          required: false
          schema:
            type: string
            description: 'Filter by origin rule name.'
            example: sample-rule
            maxLength: 191
        -
          in: query
          name: type
          description: 'Filter by origin rule type.'
          example: upstream
          required: false
          schema:
            type: string
            description: 'Filter by origin rule type.'
            example: upstream
            enum:
              - upstream
              - port
              - load_balance
        -
          in: query
          name: page
          description: 'Current page.'
          example: 1
          required: false
          schema:
            type: integer
            description: 'Current page.'
            example: 1
            nullable: true
            minimum: 1
        -
          in: query
          name: per_page
          description: 'Number of items per page.'
          example: 10
          required: false
          schema:
            type: integer
            description: 'Number of items per page.'
            example: 10
            nullable: true
            minimum: 1
            maximum: 100
      responses:
        200:
          description: Success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Operation finished successfully.'
                  data:
                    -
                      id: 19rEvwaq
                      name: upstream-rule
                      type: upstream
                      upstream_ip: 1.1.1.1
                      port: null
                      load_balance: null
                      enabled: true
                      priority: 1
                    -
                      id: wg0ljPrK
                      name: port-rule
                      type: port
                      upstream_ip: null
                      port: 80
                      load_balance: null
                      enabled: true
                      priority: 2
                    -
                      id: 19rEEerq
                      name: load-balance-rule
                      type: load_balance
                      upstream_ip: null
                      port: null
                      load_balance:
                        id: AbCdEfGh
                        name: primary-lb
                      enabled: true
                      priority: 3
                  meta:
                    current_page: 1
                    last_page: 1
                    per_page: 10
                    total: 3
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: 'Operation finished successfully.'
                  data:
                    type: array
                    example:
                      -
                        id: 19rEvwaq
                        name: upstream-rule
                        type: upstream
                        upstream_ip: 1.1.1.1
                        port: null
                        load_balance: null
                        enabled: true
                        priority: 1
                      -
                        id: wg0ljPrK
                        name: port-rule
                        type: port
                        upstream_ip: null
                        port: 80
                        load_balance: null
                        enabled: true
                        priority: 2
                      -
                        id: 19rEEerq
                        name: load-balance-rule
                        type: load_balance
                        upstream_ip: null
                        port: null
                        load_balance:
                          id: AbCdEfGh
                          name: primary-lb
                        enabled: true
                        priority: 3
                    items:
                      type: object
                      properties:
                        id:
                          type: string
                          example: 19rEvwaq
                        name:
                          type: string
                          example: upstream-rule
                        type:
                          type: string
                          example: upstream
                        upstream_ip:
                          type: string
                          example: 1.1.1.1
                        port:
                          type: string
                          example: null
                          nullable: true
                        load_balance:
                          type: string
                          example: null
                          nullable: true
                        enabled:
                          type: boolean
                          example: true
                        priority:
                          type: integer
                          example: 1
                  meta:
                    type: object
                    properties:
                      current_page:
                        type: integer
                        example: 1
                      last_page:
                        type: integer
                        example: 1
                      per_page:
                        type: integer
                        example: 10
                      total:
                        type: integer
                        example: 3
