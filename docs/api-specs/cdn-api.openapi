                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Permission Denied'
                  errors:
                    type: array
                    example: []
        404:
          description: 'Not found'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Not Found'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Not Found'
                  errors:
                    type: array
                    example: []
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'The x-parameter parameter is required.'
                  errors:
                    x-parameter:
                      - 'The x-parameter is required.'
                properties:
                  message:
                    type: string
                    example: 'The x-parameter parameter is required.'
                  errors:
                    type: object
                    properties:
                      x-parameter:
                        type: array
                        example:
                          - 'The x-parameter is required.'
                        items:
                          type: string
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
      tags:
        - 'Upstream Errors'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                enabled:
                  type: boolean
                  description: 'Upstream errors enabled status.'
                  example: true
              required:
                - enabled
    parameters:
      -
        in: path
        name: zone_uuid
        description: ''
        example: 123e4567-e89b-12d3-a456-426614174000
        required: true
        schema:
          type: string
