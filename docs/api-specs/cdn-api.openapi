components:
  securitySchemes:
    default:
      type: http
      scheme: bearer
      description: 'You can retrieve your token by visiting your dashboard and clicking <b>Generate API token</b>.'
security:
  -
    default: []
paths:
  '/external/api/v1/zones/{zone_uuid}/settings/get-antivirus-status':
    get:
      summary: 'Get Antivirus Status'
      operationId: getAntivirusStatus
      description: 'Get the current antivirus status for a specific zone.'
      parameters: []
      responses:
        200:
          description: Success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Antivirus status successfully retrieved'
                  data:
                    enabled: false
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: 'Antivirus status successfully retrieved'
                  data:
                    type: object
                    properties:
                      enabled:
                        type: boolean
                        example: false
        400:
          description: 'Bad Request'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Operation failed!'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Operation failed!'
                  errors:
                    type: array
                    example: []
        401:
          description: Unauthorized
          content:
            application/json:
              schema:
                type: object
                example:
                  message: Unauthenticated.
                properties:
                  message:
                    type: string
                    example: Unauthenticated.
        403:
          description: Forbidden
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Permission Denied'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Permission Denied'
                  errors:
                    type: array
                    example: []
        404:
          description: 'Not found'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Not Found'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Not Found'
                  errors:
                    type: array
                    example: []
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
      tags:
        - Antivirus
    parameters:
      -
        in: path
        name: zone_uuid
        description: ''
        example: 123e4567-e89b-12d3-a456-426614174000
        required: true
        schema:
          type: string
  '/external/api/v1/zones/{zone_uuid}/settings/update-antivirus-status':
    put:
      summary: 'Update Antivirus Status'
      operationId: updateAntivirusStatus
      description: 'Update the antivirus status for a specific zone.'
      parameters: []
      responses:
        200:
          description: Success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Operation finished successfully.'
                  data: []
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: 'Operation finished successfully.'
                  data:
                    type: array
                    example: []
        400:
          description: 'Bad Request'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Operation failed!'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Operation failed!'
                  errors:
                    type: array
                    example: []
        401:
          description: Unauthorized
          content:
            application/json:
              schema:
                type: object
                example:
                  message: Unauthenticated.
                properties:
                  message:
                    type: string
                    example: Unauthenticated.
        403:
          description: Forbidden
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Permission Denied'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Permission Denied'
                  errors:
                    type: array
                    example: []
        404:
          description: 'Not found'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Not Found'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Not Found'
                  errors:
                    type: array
                    example: []
        422:
          description: 'Validation error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'The x-parameter parameter is required.'
                  errors:
                    x-parameter:
                      - 'The x-parameter is required.'
                properties:
                  message:
                    type: string
                    example: 'The x-parameter parameter is required.'
                  errors:
                    type: object
                    properties:
                      x-parameter:
                        type: array
                        example:
                          - 'The x-parameter is required.'
                        items:
                          type: string
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
