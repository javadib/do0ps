                  maxLength: 255
                value:
                  type: string
                  description: 'Value of the rate limit rule.'
                  example: 'https://example.com/*'
                enabled:
                  type: boolean
                  description: Enabled.
                  example: true
                static_interval_type:
                  type: string
                  description: 'Static interval type.'
                  example: second
                  enum:
                    - second
                    - minute
                static_interval:
                  type: integer
                  description: 'Static interval.'
                  example: 1
                  minimum: 0
                dynamic_interval_type:
                  type: string
                  description: 'Dynamic interval type.'
                  example: day
                  enum:
                    - second
                    - minute
                    - hour
                    - day
                dynamic_interval:
                  type: integer
                  description: 'Dynamic interval.'
                  example: 1
                  minimum: 0
                ip_reputation_enabled:
                  type: boolean
                  description: 'IP reputation enabled.'
                  example: true
                challenge:
                  type: string
                  description: Challenge.
                  example: js
                  enum:
                    - js
                    - block
                    - captcha
                    - allow
                    - bypass
                trust_time:
                  type: integer
                  description: 'Trust time.'
                  example: 1
                  minimum: 0
                attack_ban_time:
                  type: integer
                  description: 'Attack ban time.'
                  example: 1
                  minimum: 0
                white_list_ips:
                  type: array
                  description: 'Whitelist ips, multiple ip addresses are allowed.'
                  example: null
                  items:
                    type: string
                  nullable: true
              required:
                - name
                - value
                - enabled
                - static_interval_type
                - static_interval
                - dynamic_interval_type
                - dynamic_interval
                - challenge
                - trust_time
                - attack_ban_time
