        - Antivirus
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                enabled:
                  type: boolean
                  description: 'Antivirus enabled status.'
                  example: true
              required:
                - enabled
    parameters:
      -
        in: path
        name: zone_uuid
        description: ''
        example: 123e4567-e89b-12d3-a456-426614174000
        required: true
        schema:
          type: string
  /external/api/v1/user/bulklists:
    get:
      summary: 'Get all bulklist'
      operationId: getAllBulklist
      description: 'Get all bulklist for a specific user.'
      parameters:
        -
          in: query
          name: per_page
          description: 'The number of items per page.'
          example: 10
          required: false
          schema:
            type: integer
            description: 'The number of items per page.'
            example: 10
            nullable: true
            minimum: 1
            maximum: 100
        -
          in: query
          name: page
          description: 'The current page.'
          example: 1
          required: false
          schema:
            type: integer
            description: 'The current page.'
            example: 1
            nullable: true
            minimum: 1
      responses:
        200:
          description: success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Operation finished successfully.'
                  data:
                    -
                      id: RD0kerP6
                      name: list1
                      type: country
                      items:
                        -
                          value: '1'
                          value_detail: Afghanistan
                    -
                      id: vpaO2roj
                      name: list2
                      type: ip
                      items:
                        -
                          value: 1.1.1.1
                          value_detail: null
                        -
                          value: 2.2.2.2
                          value_detail: null
                  meta:
                    current_page: 1
                    last_page: 1
                    per_page: 10
                    total: 2
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: 'Operation finished successfully.'
                  data:
                    type: array
                    example:
                      -
                        id: RD0kerP6
                        name: list1
                        type: country
                        items:
                          -
                            value: '1'
                            value_detail: Afghanistan
                      -
                        id: vpaO2roj
                        name: list2
                        type: ip
                        items:
                          -
                            value: 1.1.1.1
                            value_detail: null
                          -
                            value: 2.2.2.2
                            value_detail: null
                    items:
                      type: object
                      properties:
                        id:
                          type: string
                          example: RD0kerP6
                        name:
                          type: string
                          example: list1
                        type:
                          type: string
                          example: country
                        items:
                          type: array
                          example:
                            -
                              value: '1'
                              value_detail: Afghanistan
                          items:
                            type: object
                            properties:
                              value:
                                type: string
                                example: '1'
                              value_detail:
                                type: string
                                example: Afghanistan
                  meta:
                    type: object
                    properties:
                      current_page:
                        type: integer
                        example: 1
                      last_page:
                        type: integer
                        example: 1
                      per_page:
                        type: integer
                        example: 10
                      total:
                        type: integer
                        example: 2
        401:
          description: Unauthorized
          content:
            application/json:
              schema:
                type: object
                example:
                  message: Unauthenticated.
                properties:
                  message:
                    type: string
                    example: Unauthenticated.
        403:
          description: Forbidden
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Permission Denied'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Permission Denied'
                  errors:
                    type: array
                    example: []
        404:
          description: 'Not found'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Not Found'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Not Found'
                  errors:
                    type: array
                    example: []
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
      tags:
        - Bulklist
    post:
      summary: 'Create a new bulklist'
      operationId: createANewBulklist
      description: 'Create a new bulklist for a specific user.'
      parameters: []
      responses:
        201:
          description: Success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Operation finished successfully.'
                  data: []
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: 'Operation finished successfully.'
                  data:
                    type: array
                    example: []
        400:
          description: 'Bad Request'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Operation failed!'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Operation failed!'
                  errors:
                    type: array
                    example: []
        401:
          description: Unauthorized
          content:
            application/json:
              schema:
                type: object
                example:
                  message: Unauthenticated.
                properties:
                  message:
                    type: string
                    example: Unauthenticated.
        403:
          description: Forbidden
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Permission Denied'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Permission Denied'
                  errors:
                    type: array
                    example: []
        404:
          description: 'Not found'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Not Found'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Not Found'
                  errors:
                    type: array
                    example: []
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
      tags:
        - Bulklist
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                name:
                  type: string
                  description: 'Name of the bulklist.'
                  example: 'Blocked IPs'
                  maxLength: 255
                type:
                  type: string
                  description: 'Type of the bulklist.'
                  example: ip
                  enum:
                    - ip
                    - user_agent
                    - country
                    - referral
                items:
                  type: array
                  description: 'Items in the bulklist.'
                  example:
                    - 192.168.0.1
                  items:
                    type: string
                    maxLength: 255
                  minItems: 1
              required:
                - name
                - type
                - items
