                      type: string
                      description: 'The server group(primary or backup).'
                      example: primary
                      enum:
                        - primary
                        - backup
                    active:
                      type: boolean
                      description: 'Specifies whether the server is active.'
                      example: true
                  required:
                    - name
                    - ip
                    - active
              required:
                - name
                - enabled
                - servers
