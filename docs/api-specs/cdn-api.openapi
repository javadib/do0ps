  '/external/api/v1/zones/{zone_uuid}/cache/ttl':
    put:
      summary: 'Update Cache TTL'
      operationId: updateCacheTTL
      description: 'Update the TTL value for edge cache.'
      parameters: []
      responses:
        200:
          description: Success
          content:
            application/json:
              schema:
                type: object
                example:
                  success: true
                  message: 'Operation finished successfully.'
                  data: []
                properties:
                  success:
                    type: boolean
                    example: true
                  message:
                    type: string
                    example: 'Operation finished successfully.'
                  data:
                    type: array
                    example: []
        401:
          description: Unauthorized
          content:
            application/json:
              schema:
                type: object
                example:
                  message: Unauthenticated.
                properties:
                  message:
                    type: string
                    example: Unauthenticated.
        403:
          description: Forbidden
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Permission Denied'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Permission Denied'
                  errors:
                    type: array
                    example: []
        404:
          description: 'Not found'
          content:
            application/json:
              schema:
                type: object
                example:
                  success: false
                  message: 'Not Found'
                  errors: []
                properties:
                  success:
                    type: boolean
                    example: false
                  message:
                    type: string
                    example: 'Not Found'
                  errors:
                    type: array
                    example: []
        500:
          description: 'Server error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'Server Error'
                properties:
                  message:
                    type: string
                    example: 'Server Error'
      tags:
        - 'Cache Management'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                edge_cache_ttl:
                  type: integer
                  description: 'The TTL value for edge cache.'
                  example: 10800
                  enum:
                    - 1
                    - 2
                    - 5
                    - 10
                    - 30
                    - 60
                    - 180
                    - 300
                    - 600
                    - 900
                    - 1800
                    - 2700
                    - 3600
                    - 10800
                    - 18000
                    - 36000
                    - 43200
                    - 86400
                    - 259200
                    - 604800
                    - 864000
                    - 1296000
                    - 2592000
              required:
                - edge_cache_ttl
    parameters:
      -
        in: path
        name: zone_uuid
        description: ''
        example: 123e4567-e89b-12d3-a456-426614174000
