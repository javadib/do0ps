                  type: array
                  description: 'Removable headers.'
                  example:
                    - X-Powered-By
                  items:
                    type: string
                    minLength: 1
                    maxLength: 255
                  nullable: true
                  maxItems: 50
                url_redirection:
                  type: object
                  description: 'Url Redirection.'
                  example:
                    http_code: 301
                    url: 'https://example.com/new-path'
                  properties:
                    http_code:
                      type: integer
                      description: 'http code.'
                      example: 301
                      enum:
                        - 301
                        - 302
                    url:
                      type: string
                      description: url.
                      example: 'https://example.com/new-path'
                      maxLength: 255
                  nullable: true
                addition_headers:
                  type: object
                  description: 'Additional headers.'
                  example:
                    access-control-allow-headers: '*'
                  nullable: true
                  maxItems: 50
                  minProperties: 0
                  additionalProperties: true
                port_destination:
                  type: object
                  description: 'Port Destination.'
                  example:
                    http: 80
                    https: 443
                  properties:
                    http:
                      type: integer
                      description: 'http port.'
                      example: 80
                      nullable: true
                      minimum: 1
                      maximum: 65535
                    https:
                      type: integer
                      description: 'https port.'
                      example: 443
                      nullable: true
                      minimum: 1
                      maximum: 65535
                  nullable: true
                addition_cookies:
                  type: array
                  description: 'Additional cookies.'
                  example:
                    -
                      key: session_id
                      value: abc123
                      expire_date: 3600
                      path: /
                      http_only: false
                      secure: false
                  items:
                    type: object
                    properties:
                      key:
                        type: string
                        description: ''
                        example: session_id
                        maxLength: 255
                      value:
                        type: string
                        description: ''
                        example: abc123
                        maxLength: 255
                      expire_date:
                        type: integer
                        description: ''
                        example: 3600
                        nullable: true
                        minimum: 0
                        maximum: 86400
                      path:
                        type: string
                        description: ''
                        example: /
                        nullable: true
                        maxLength: 255
                      http_only:
                        type: boolean
                        description: ''
                        example: false
                        nullable: true
                        enum:
                          - 'true'
                          - 'false'
                      secure:
                        type: boolean
                        description: ''
                        example: false
                        nullable: true
                        enum:
                          - 'true'
                          - 'false'
                    required:
                      - key
                      - value
                  nullable: true
                  maxItems: 20
              required:
                - name
                - value
                - firewall_status
