openapi: 3.0.3
info:
  title: 'Parspack CDN Public API'
  description: ''
  version: 1.0.0
servers:
  -
    url: 'https://my.parspack.com/cdnapi'
tags:
  -
    name: Antivirus
    description: ''
  -
    name: Bulklist
    description: ''
