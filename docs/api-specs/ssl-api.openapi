                  type: string
                  description: 'Sort direction. Valid values: asc, desc'
                  example: desc
                  nullable: false
  /api/public/v1/order/addOrder:
    post:
      summary: 'Create a New SSL Order'
      operationId: createANewSSLOrder
      description: "<aside class=\"notice\">Create a new SSL order</aside>\nAn SSL certificate order will be created using the provided information. The response body will contain a JSON object with order details including order ID, invoice information, and payment status.\n\nThe response code, 200 OK, indicates that the order has been successfully created and an invoice has been generated. The order will be in pending status until the invoice is paid.\n\n<aside class=\"warning\">Important Notes</aside>\n- The order must be paid before proceeding with certificate issuance\n- Use the returned <span style=\"color: red;\">order_id</span> for subsequent operations (CSR upload, contact details, etc.)\n- For wildcard certificates, the domain should NOT include the wildcard prefix (*)\n- For multi-domain certificates, use the <span style=\"color: red;\">sans</span> parameter to specify additional domains\n\n<aside class=\"info\">SANs Structure</aside>\nEach SAN (Subject Alternative Name) must be an object with the following fields:\n- **name**: The domain name (required)\n- **is_ip**: Boolean indicating if it's an IP address (required)\n- **www**: Integer (0 or 1) to include www subdomain (required)\n\nExample SANs array:\n```json\n[\n    {\"name\": \"s151.domain.com\", \"is_ip\": false, \"www\": 0},\n    {\"name\": \"s152.domain.com\", \"is_ip\": false, \"www\": 1}\n]\n```"
      parameters: []
      responses:
        200:
          description: 'Order created successfully'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: success
                  code: 200
                  data:
                    order_id: 07e0-32ff-f210-b126
                    invoice_id: 2112
                    invoice_status: unpaid
                  status: true
                properties:
                  message:
                    type: string
                    example: success
                    description: 'A message indicating the result of the operation.'
                    enum: []
                  code:
                    type: integer
                    example: 200
                    description: 'HTTP status code of the response.'
                    enum: []
                  data:
                    type: object
                    properties:
                      order_id:
                        type: string
                        example: 07e0-32ff-f210-b126
                        description: 'A unique encrypted identifier for the SSL order. This ID should be used for all subsequent operations related to this order.'
                        enum: []
                      invoice_id:
                        type: integer
                        example: 2112
                        description: 'Unique identifier for the invoice in the billing system.'
                        enum: []
                      invoice_status:
                        type: string
                        example: unpaid
                        description: 'Current payment status of the invoice. Possible values: unpaid, paid, cancelled, refunded.'
                        enum: []
                    required:
                      - order_id
                      - invoice_id
                      - invoice_status
                    description: 'Contains the order details and invoice information.'
                  status:
                    type: boolean
                    example: true
                    description: 'Indicates whether the operation was successful.'
                    enum: []
                required:
                  - message
                  - code
                  - data
                  - status
        401:
          description: 'Authentication Required'
          content:
            application/json:
              schema:
                type: object
                example:
                  id: unauthorized
                  message: Unauthenticated.
                properties:
                  id:
                    type: string
                    example: unauthorized
                  message:
                    type: string
                    example: Unauthenticated.
                    description: 'A message indicating the result of the operation.'
                    enum: []
                required:
                  - message
        422:
          description: 'Validation Error'
          content:
            application/json:
              schema:
                type: object
                example:
                  message: 'The given data was invalid.'
                  code: 422
                  errors:
                    product_slug:
                      - 'The selected product slug is invalid or the product is not available.'
                    domain:
                      - 'The domain field is required.'
                    billing_cycle:
                      - 'The selected billing cycle is invalid.'
                  status: false
                properties:
                  message:
                    type: string
                    example: 'The given data was invalid.'
                    description: 'A message indicating the result of the operation.'
                    enum: []
                  code:
                    type: integer
                    example: 422
                    description: 'HTTP status code of the response.'
                    enum: []
                  errors:
                    type: object
                    properties:
                      product_slug:
                        type: array
                        example:
                          - 'The selected product slug is invalid or the product is not available.'
                        items:
                          type: string
                      domain:
                        type: array
                        example:
                          - 'The domain field is required.'
                        items:
                          type: string
                      billing_cycle:
                        type: array
                        example:
                          - 'The selected billing cycle is invalid.'
                        items:
                          type: string
                  status:
                    type: boolean
                    example: false
                    description: 'Indicates whether the operation was successful.'
                    enum: []
                required:
                  - message
                  - code
                  - status
      tags:
        - 'SSL Orders'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              type: object
              properties:
                product_slug:
                  type: string
                  description: 'The unique slug identifier for the SSL product. Use the /general/products endpoint to get available products.'
                  example: dv-ssl
                  nullable: false
                domain:
                  type: string
                  description: 'The primary domain name for the SSL certificate. Must be a valid domain without protocol (http/https) or www prefix unless explicitly needed.'
                  example: example.com
                  nullable: false
                billing_cycle:
                  type: string
                  description: 'The billing cycle for the certificate. Must be one of: annually, biennially, triennially.'
                  example: annually
                  nullable: false
                www:
                  type: boolean
                  description: 'Include www subdomain in the certificate. Only applicable for certain certificate types. Set to true to include both example.com and www.example.com.'
                  example: true
                  nullable: false
                promocode:
                  type: string
                  description: 'Optional promotional code for discount. Will be validated against active promotions in the billing system.'
                  example: SUMMER2024
                  nullable: false
                sans:
                  type: array
                  description: 'Additional Subject Alternative Names (SANs) for multi-domain certificates. Only applicable for multi-domain products. Each SAN must be an object with name, is_ip, and www fields.'
                  example:
                    -
                      name: s151.example.com
                      is_ip: false
                      www: 0
                    -
                      name: s152.example.com
                      is_ip: false
                      www: 1
                  items:
                    type: object
                    properties:
                      name:
                        type: string
                        description: 'The domain name for this SAN. Must be a valid domain (max 64 characters).'
                        example: s151.domain.com
                        nullable: false
                      is_ip:
                        type: boolean
                        description: 'Whether this SAN is an IP address. Set to false for domain names, true for IP addresses.'
                        example: false
                        nullable: false
                      www:
                        type: integer
                        description: 'Include www subdomain for this SAN. 0 = no www, 1 = include www.'
                        example: 0
                        nullable: false
              required:
                - product_slug
                - domain
                - billing_cycle
