# do0ps environment configuration. Copy to .env or export directly.
# MCP_AUTH_TOKENS is the only required variable; the rest have defaults.

# Comma-separated list of allowed MCP access tokens in "token:client_id[:name]"
# form (tokens must be at least 16 characters). Required -- the server refuses
# to start without it.
# Example: MCP_AUTH_TOKENS="change-me-0123456789:client-a,change-me-9876543210:client-b"
MCP_AUTH_TOKENS=

# Path to the SQLite job-store database file. Its parent directory is created
# automatically if missing.
# Default: ./data/do0ps.db
DB_PATH=./data/do0ps.db

# Port the MCP server (Streamable HTTP) listens on.
# Default: 8080
HTTP_PORT=8080

# Structured logger level: debug, info, warn, or error.
# Default: info
LOG_LEVEL=info

# Number of worker goroutines processing queued jobs.
# Default: 8
DO0PS_QUEUE_WORKERS=8

# Maximum number of jobs buffered in the in-process queue.
# Default: 256
DO0PS_QUEUE_DEPTH=256

# How often a running long-operation job is polled against the provider.
# Default: 10s
DO0PS_POLL_INTERVAL=10s

# How long a long operation is allowed to take before it is marked failed.
# Default: 20m
DO0PS_POLL_TIMEOUT=20m

# How long shutdown waits for in-flight jobs to drain before giving up.
# Default: 30s
DO0PS_SHUTDOWN_WAIT=30s
