# do0ps environment configuration. Copy to .env or export directly.
# MCP_AUTH_TOKENS is the only required variable; the rest have defaults.

# Comma-separated list of allowed MCP access tokens in "token:client_id[:name]"
# form (tokens must be at least 16 characters). Required for the HTTP transport
# -- the server refuses to start without it. Not used under MCP_TRANSPORT=stdio,
# which has no listener to guard.
# Example: MCP_AUTH_TOKENS="change-me-0123456789:client-a,change-me-9876543210:client-b"
MCP_AUTH_TOKENS=

# Transport MCP clients reach the server through: "http" (Streamable HTTP over
# Fiber, the self-hosted deployment) or "stdio" (the chat client spawns this
# binary itself, which is how an installed MCP bundle runs -- see
# docs/mcp-bundle.md). The --stdio flag does the same thing.
# Default: http
MCP_TRANSPORT=http

# Bridge mode, for the MCP bundle only: point this process at a self-hosted
# do0ps server instead of running the adapters in-process. An installed bundle
# fills these in from the two fields in its extension settings. Leave both
# empty to run the server locally. See docs/mcp-bundle.md.
# DO0PS_SERVER_URL=https://do0ps.example.com/mcp
# DO0PS_AUTH_TOKEN=

# Path to the SQLite job-store database file. Its parent directory is created
# automatically if missing. Under MCP_TRANSPORT=stdio the default moves to the
# per-user config directory instead, since the chat client picks the working
# directory.
# Default: ./data/do0ps.db
DB_PATH=./data/do0ps.db

# Port the MCP server (Streamable HTTP) listens on.
# Default: 8080
HTTP_PORT=8080

# Structured logger level: debug, info, warn, or error.
# Default: info
LOG_LEVEL=info

# Number of worker goroutines processing queued jobs.
# Default: 8
DO0PS_QUEUE_WORKERS=8

# Maximum number of jobs buffered in the in-process queue.
# Default: 256
DO0PS_QUEUE_DEPTH=256

# How often a running long-operation job is polled against the provider.
# Default: 10s
DO0PS_POLL_INTERVAL=10s

# How long a long operation is allowed to take before it is marked failed.
# Default: 20m
DO0PS_POLL_TIMEOUT=20m

# How long shutdown waits for in-flight jobs to drain before giving up.
# Default: 30s
DO0PS_SHUTDOWN_WAIT=30s
